# Copy this file to .env and fill in real values before running the app.
# Never commit .env to version control.

NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call this API (CORS).
# The frontend README has it running on :3001 by default to avoid
# colliding with this backend's default :3000.
FRONTEND_URL=http://localhost:3001

# Matches docker-compose.yml's postgres service by default. This is the
# RESTRICTED role (yaseetech_app) the running application connects as --
# created automatically by docker/init-app-role.sql on first container
# startup for local dev.
#
# CRITICAL: this must never be a superuser. PostgreSQL superusers silently
# bypass Row-Level Security -- if this points at a superuser account
# (Railway, Supabase, and most managed Postgres providers hand you one by
# default), every RLS policy in this schema is ignored and tenant data
# leaks across businesses. See "Critical: the database role you connect
# as MUST NOT be a superuser" in README.md.
DATABASE_URL=postgres://yaseetech_app:yaseetech_app_dev_password@localhost:5432/yaseetech

# The ADMIN connection, used only by `npm run migrate` and `npm run seed`
# (see scripts/migrate.js). Needs real privileges (CREATE TABLE, CREATE
# TRIGGER, CREATE EXTENSION) that the restricted DATABASE_URL role above
# deliberately doesn't have. For local dev this is docker-compose's
# bootstrap superuser; in a real deployment, use your provider's admin
# connection string here and the restricted role's string above.
MIGRATIONS_DATABASE_URL=postgres://yaseetech:yaseetech_dev_password@localhost:5432/yaseetech

# Access tokens are signed JWTs (short-lived, per Phase 1 Section 4.1).
# Generate a real secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens are NOT JWTs -- they're random opaque strings, stored as a
# hash in refresh_tokens, so they can be individually revoked (a compromised
# JWT can't be un-issued; a compromised opaque token's hash can be deleted).
# No secret needed for these, just an expiry window.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
